# ─────────────────────────────────────────────────────────────────────────────
# AeroBMSCE environment variables
# Copy this file to `.env.local` and fill in values from your Supabase project
# (Supabase Dashboard → Project Settings → API).
# ─────────────────────────────────────────────────────────────────────────────

# Public — safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Server ONLY — bypasses Row Level Security. NEVER expose to the client / browser.
# Used in route handlers / server actions for admin operations and signed uploads.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

# Absolute site URL (used for auth redirects). No trailing slash.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
